<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiApp.ViewModels"
             x:Class="MauiApp.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Title="{Binding Title}">
    <VerticalStackLayout>
        <ActivityIndicator IsRunning="{Binding IsBusy}" />
        <Entry x:Name="QueryBox" Text="{Binding Query, Mode=TwoWay}" />
        <Label Text="{Binding Profile.DisplayName}" />
        <Button Command="{Binding SearchCommand, CommandParameter={Binding Query}}" />

        <CollectionView ItemsSource="{Binding Results}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:SearchResult">
                    <Label Text="{Binding Title}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <CollectionView ItemsSource="{Binding Results}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding Path=Title}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
